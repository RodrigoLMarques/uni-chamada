Project unichamada {
  database_type: 'PostgreSQL'
  Note: 'Schema MVP. Fonte da verdade continua sendo backend/prisma/schema.prisma.'
}

Table app_user {
  id bigint [pk, increment]
  email text [not null, unique]
  name text [not null]
  password_hash text [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Professor (teacher no codigo). "user" e reservada no Postgres, a tabela se chama "users".'
}

Table student {
  id bigint [pk, increment]
  ra text [not null, unique]
  name text [not null]
  email text
  photo_url text
  entry_year int [note: 'ano de ingresso na faculdade']

  Note: 'Aluno nao faz login; identificado pelo RA. Um RA = uma pessoa. Email, foto e ano de ingresso sao opcionais.'
}

Table course {
  id bigint [pk, increment]
  teacher_id bigint [not null, ref: > app_user.id]
  code text [not null]
  name text [not null]
  term text [not null, note: 'ex.: 2026.2']
  period text [not null, note: 'CHECK: FULL_TIME | EVENING']

  indexes {
    (teacher_id, code, term, period) [unique]
    teacher_id [name: 'idx_course_teacher']
  }

  Note: 'Oferta da disciplina no semestre (turma). A chave inclui teacher e period porque o mesmo codigo no mesmo semestre em turmas diferentes e normal.'
}

Table enrollment {
  course_id bigint [not null, ref: > course.id]
  student_id bigint [not null, ref: > student.id]
  status text [not null, default: 'ACTIVE', note: 'CHECK: ACTIVE | DROPPED']
  enrolled_at timestamptz [not null, default: `now()`]

  indexes {
    (course_id, student_id) [pk]
  }

  Note: 'Denominador da frequencia. Trancamento = status, nao DELETE.'
}

Table student_device {
  id bigint [pk, increment]
  student_id bigint [not null, ref: > student.id]
  token_hash text [not null, unique, note: 'nunca o token em claro']
  created_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz

  indexes {
    student_id [name: 'idx_device_student']
  }

  Note: 'Cada re-vinculo e uma linha nova.'
}

Table class_session {
  id bigint [pk, increment]
  course_id bigint [not null, ref: > course.id]
  starts_at timestamptz [not null]
  opened_at timestamptz [note: 'QR comecou a rodar']
  closed_at timestamptz [note: 'QR parou']
  confirmed_at timestamptz [note: 'teacher confirmou na revisao']
  latitude numeric(9,6) [note: 'local do teacher ao abrir; referencia para a distancia']
  longitude numeric(9,6)
  accuracy_m real

  indexes {
    (course_id, starts_at) [unique]
  }

  Note: 'O QR e stateless: HMAC(class_session_id + janela de 3s + secret). Nao ha tabela de token. O status (SCHEDULED/OPEN/CLOSED/CONFIRMED) e derivado dos timestamps, nao e coluna.'
}

Table attendance {
  id bigint [pk, increment]
  class_session_id bigint [not null, ref: > class_session.id]
  student_id bigint [not null, ref: > student.id]
  device_id bigint [ref: > student_device.id, note: 'NULL se MANUAL']
  method text [not null, note: 'CHECK: QR | MANUAL']
  recorded_at timestamptz [not null, default: `now()`]
  client_ip inet
  latitude numeric(9,6)
  longitude numeric(9,6)
  accuracy_m real

  indexes {
    (class_session_id, student_id) [unique]
    (device_id, class_session_id) [name: 'idx_attendance_device']
  }

  Note: 'Sinais crus; flags de suspeita sao derivadas em query. Mesmo celular duas vezes na sessao nao e bloqueado, e avisado ao teacher.'
}
