generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum CoursePeriod {
  FULL_TIME
  EVENING
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  courses Course[]

  @@map("users")
}

model Student {
  id        BigInt  @id @default(autoincrement())
  ra        String  @unique
  name      String
  email     String?
  photoUrl  String? @map("photo_url")
  entryYear Int?    @map("entry_year")

  enrollments Enrollment[]

  @@map("student")
}

model Course {
  id        BigInt       @id @default(autoincrement())
  teacherId BigInt       @map("teacher_id")
  code      String
  name      String
  term      String
  period    CoursePeriod

  teacher     User           @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@unique([teacherId, code, term, period])
  @@index([teacherId], map: "idx_course_teacher")
  @@map("course")
}

model Enrollment {
  courseId   BigInt           @map("course_id")
  studentId  BigInt           @map("student_id")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz

  course  Course  @relation(fields: [courseId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([courseId, studentId])
  @@map("enrollment")
}

model ClassSession {
  id          BigInt    @id @default(autoincrement())
  courseId    BigInt    @map("course_id")
  startsAt    DateTime  @map("starts_at") @db.Timestamptz
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  closedAt    DateTime? @map("closed_at") @db.Timestamptz
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  accuracyM   Float?    @map("accuracy_m") @db.Real

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, startsAt])
  @@map("class_session")
}
