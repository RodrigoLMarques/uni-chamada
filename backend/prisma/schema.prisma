generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum CoursePeriod {
  FULL_TIME
  EVENING
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum Institution {
  UNIFESP
  OTHER
}

model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  courses Course[]

  @@map("users")
}

model Student {
  id        String  @id @default(cuid(2))
  ra        String  @unique
  name      String
  email     String?
  photoUrl  String? @map("photo_url")
  photoKey  String? @map("photo_key")
  entryYear Int?    @map("entry_year")

  enrollments Enrollment[]
  devices     StudentDevice[]
  attendances Attendance[]

  @@map("student")
}

model Course {
  id          String       @id @default(cuid(2))
  teacherId   String       @map("teacher_id")
  code        String
  name        String
  term        String
  period      CoursePeriod
  institution Institution  @default(OTHER)

  teacher     User           @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@unique([teacherId, code, term, period])
  @@index([teacherId], map: "idx_course_teacher")
  @@map("course")
}

model Enrollment {
  courseId   String           @map("course_id")
  studentId  String           @map("student_id")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz

  course  Course  @relation(fields: [courseId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([courseId, studentId])
  @@map("enrollment")
}

model ClassSession {
  id          String    @id @default(cuid(2))
  courseId    String    @map("course_id")
  startsAt    DateTime  @map("starts_at") @db.Timestamptz
  openedAt    DateTime? @map("opened_at") @db.Timestamptz
  closedAt    DateTime? @map("closed_at") @db.Timestamptz
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  accuracyM   Float?    @map("accuracy_m") @db.Real

  course      Course       @relation(fields: [courseId], references: [id])
  attendances Attendance[]

  @@unique([courseId, startsAt])
  @@map("class_session")
}

model StudentDevice {
  id        String    @id @default(cuid(2))
  studentId String    @map("student_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  student     Student      @relation(fields: [studentId], references: [id])
  attendances Attendance[]

  @@index([studentId], map: "idx_device_student")
  @@map("student_device")
}

model Attendance {
  id             String           @id @default(cuid(2))
  classSessionId String           @map("class_session_id")
  studentId      String           @map("student_id")
  deviceId       String?          @map("device_id")
  method         AttendanceMethod
  recordedAt     DateTime         @default(now()) @map("recorded_at") @db.Timestamptz
  clientIp       String?          @map("client_ip") @db.Inet
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  accuracyM      Float?           @map("accuracy_m") @db.Real

  classSession ClassSession   @relation(fields: [classSessionId], references: [id])
  student      Student        @relation(fields: [studentId], references: [id])
  device       StudentDevice? @relation(fields: [deviceId], references: [id])

  @@unique([classSessionId, studentId])
  @@index([deviceId, classSessionId], map: "idx_attendance_device")
  @@map("attendance")
}
