FROM node:26-alpine
WORKDIR /home/node/app

RUN chown node:node /home/node/app
USER node

COPY --chown=node:node package.json package-lock.json ./

RUN npm ci

EXPOSE 3000
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && ./node_modules/.bin/prisma generate && ./node_modules/.bin/prisma db seed && npm run start:dev"]
